# ==============================================================================
# SMRITI PLATFORM - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Supabase Auth & Storage (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Admin / Service Role Key (NEVER expose to client, never use NEXT_PUBLIC prefix)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# PostgreSQL Database Connections (Project Settings > Database)
# DATABASE_URL = Transaction pooled connection (port 6543, pgbouncer=true) for serverless queries
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL = Direct connection (port 5432) for Prisma CLI migrations & schema updates
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Cron secret for securing Stage 2 scheduled endpoints (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="generate-a-secure-random-token-min-32-chars"

# ==============================================================================
# STAGE 2: EMAIL DISPATCH CONFIGURATION (Nodemailer over SMTP)
# ==============================================================================
# Typically Gmail SMTP with an App Password (16 characters)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-gmail-app-password"
SMTP_FROM="Smriti Elder Care <your-email@gmail.com>"

# ==============================================================================
# STAGE 2: GOOGLE GEMINI AI CONFIGURATION (@google/genai)
# ==============================================================================
# Google AI Studio API key
GEMINI_API_KEY="your-gemini-api-key"
# Model defaults to gemini-2.5-flash
GEMINI_MODEL="gemini-2.5-flash"

# ==============================================================================
# STAGE 3: FRONTEND DEMO CREDENTIALS
# ==============================================================================
# Enable one-tap demo account shortcuts on the login page
NEXT_PUBLIC_DEMO_MODE="true"

# Pre-seeded demo credentials for instant testing
NEXT_PUBLIC_DEMO_DOCTOR_ID="dr.anjali@smriti.app"
NEXT_PUBLIC_DEMO_DOCTOR_PASS="Password@123"

NEXT_PUBLIC_DEMO_ELDER_ID="+919811122332"
NEXT_PUBLIC_DEMO_ELDER_PASS="Password@123"

NEXT_PUBLIC_DEMO_CARETAKER_ID="pooja.sawant@care.in"
NEXT_PUBLIC_DEMO_CARETAKER_PASS="Password@123"

NEXT_PUBLIC_DEMO_FAMILY_ID="amit.sharma@family.com"
NEXT_PUBLIC_DEMO_FAMILY_PASS="Password@123"
